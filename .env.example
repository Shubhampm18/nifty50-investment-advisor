# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file — it stays local (see .gitignore).

# --- LLM provider (required for research) ---
# Supported providers: openai, groq, google, nvidia
LLM_PROVIDER=nvidia

# Optional: override the model for the active provider.
# If unset, the per-provider defaults apply:
#   openai -> gpt-4o-mini
#   groq   -> llama-3.3-70b-versatile
#   google -> gemini-2.5-flash
#   nvidia -> z-ai/glm-5.3-flash
LLM_MODEL=

# Optional per-provider model overrides
OPENAI_MODEL=
GROQ_MODEL=
GOOGLE_MODEL=
NVIDIA_MODEL=

# --- Provider API keys (only the active provider's key is required) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Optional NVIDIA custom endpoint
NVIDIA_BASE_URL=

# --- Persistence (optional; defaults shown) ---
# SQLite database path (relative paths resolve from the project root)
DATABASE_PATH=data/paper_trading.db

# Default starting cash for a new paper portfolio (₹)
INITIAL_PAPER_CASH=100000
